## Example env for local dev (do not commit real secrets)
#
# Note: variables with VITE_ are embedded into the frontend bundle and are NOT secret.
# Use this only for local convenience; for real protection use a backend.
#
# Optional. If empty/unset, the app will предложить задать пароль и сохранит его в localStorage.
VITE_ADMIN_PASSWORD=

# Optional. Base URL for stats API (default: same origin).
# Example: http://localhost:8080
VITE_STATS_API_BASE=
